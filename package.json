{
  "name": "rolling",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @rolling/web build && pnpm --filter @rolling/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build:ci": "pnpm install --frozen-lockfile && pnpm --filter @rolling/web build"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
