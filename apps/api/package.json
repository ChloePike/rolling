{
  "name": "@rolling/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply rolling-dev --local",
    "db:migrate:staging": "wrangler d1 migrations apply rolling-staging --remote --env staging",
    "stripe:sync": "tsx scripts/stripe-sync.ts"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.0.30",
    "@rolling/agent": "workspace:*",
    "@rolling/core": "workspace:*",
    "@rolling/db": "workspace:*",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.28",
    "drizzle-orm": "^0.44.7",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.16.0",
    "hono": "^4.10.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261125.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.45.0"
  }
}
