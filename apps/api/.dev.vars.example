# Local secrets for `wrangler dev`: copy to `.dev.vars` (git-ignored) and fill in.
# Deployed environments: `wrangler secret put <NAME> --env staging|production`.
# Empty values are fine locally: auth uses a development-only secret, email codes are
# logged instead of sent, and Google / Apple sign-in are hidden until configured.

HYPEROUTER_API_KEY=
# Standard Webhooks secret (whsec_...) of the Hyperouter webhook endpoint pointing at /api/hooks/hyperouter.
HYPEROUTER_WEBHOOK_SECRET=

# Better Auth: 32+ random bytes (e.g. `openssl rand -base64 32`). Required outside development.
BETTER_AUTH_SECRET=

# Email (Resend). Without it, development records and logs messages instead.
RESEND_API_KEY=

# Only with the EMAIL_PROVIDER=test-inbox var (staging e2e): bearer token for GET /api/test/inbox.
TEST_INBOX_TOKEN=

# Google OAuth client (Web). Redirect URI: <PUBLIC_APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple. APPLE_CLIENT_ID is the Services ID; return URL: <PUBLIC_APP_URL>/api/auth/callback/apple
# Either APPLE_CLIENT_SECRET (a pre-signed ES256 JWT) or the three values below, from which
# the Worker signs one: team id, key id and the .p8 private key (PEM, `\n` for newlines).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Optional: iOS bundle id when ID tokens come from a native app (not used by the web app).
APPLE_APP_BUNDLE_IDENTIFIER=

# Stripe (M2). Test-mode secret key and the webhook signing secret
# (`stripe listen --forward-to localhost:8787/api/stripe/webhook` prints one locally).
# Create the plan products/prices once per account: `pnpm --filter @rolling/api stripe:sync`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: pin the API version; unset uses the account default.
STRIPE_API_VERSION=

# Media (M3, D-008): HMAC key for signed private media URLs. Required outside development
# (development falls back to a fixed dev key). Generate with `openssl rand -base64 32`.
MEDIA_SIGNING_KEY=
# Skip the FFmpeg container in media processing when Docker/containers are not running locally.
MEDIA_CONTAINER=off
# Direct browser uploads to R2 (D-011): an R2 API token (Object Read & Write on the media bucket).
# Without them, development falls back to a Worker part proxy; staging/production refuse uploads.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
