# Workers static assets (the `assets` binding; local dev and CI deploys). The R2-served
# path sets the same headers in apps/api/src/lib/r2Static.ts.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/manifest.webmanifest
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# Review links (D-031): the token is in the path; never cached, never sent as a referrer, never indexed.
/review/*
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
